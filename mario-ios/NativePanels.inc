 [rows addObject:[MenuController action:@"importSave" label:@"استيراد حفظ من الملفات" detail:@".vsave"]];self.saveMenu=[self menu:@"الحفظات" groups:@[[self group:@"آخر حفظ والخانات والحفظات السابقة" rows:rows note:self.store.records.count?@"اختر حفظًا لاستعادته أو تصديره أو حذفه.":@"لا توجد حفظات بعد. العب ثم اضغط حفظ."]]];__weak GameController *w=self;self.saveMenu.action=^(NSString *key){if([key hasPrefix:@"save:"])[w saveActions:[key substringFromIndex:5]];else [w menuAction:key];};
