 [a addAction:[UIAlertAction actionWithTitle:@"استعادة" style:UIAlertActionStyleDefault handler:^(UIAlertAction *x){BOOL ok=[self.engine restoreState:[self.store state:name]];[self dismissViewControllerAnimated:YES completion:^{self.engine.paused=self.modalWasPaused;[self updatePause];[self showNotice:ok?@"تمت استعادة الحفظ":@"الحفظ تالف أو غير متوافق"];}];}]];
