- (void)updateController:(GCExtendedGamepad *)p{
 if(![self.prefs[@"input"] isEqual:@"controller"])return;double d=[self.prefs[@"deadzone"] doubleValue];
 NSDictionary *pressed=@{@"a":@(p.buttonA.pressed),@"b":@(p.buttonB.pressed),@"x":@(p.buttonX.pressed),@"y":@(p.buttonY.pressed),@"l":@(p.leftShoulder.pressed),@"r":@(p.rightShoulder.pressed),@"menu":@(p.buttonMenu.pressed),@"options":@(p.buttonOptions.pressed),@"up":@(p.dpad.up.pressed||p.leftThumbstick.yAxis.value>d),@"down":@(p.dpad.down.pressed||p.leftThumbstick.yAxis.value < -d),@"left":@(p.dpad.left.pressed||p.leftThumbstick.xAxis.value < -d),@"right":@(p.dpad.right.pressed||p.leftThumbstick.xAxis.value>d)};
 for(NSNumber *id in @[@0,@8,@2,@3,@4,@5,@6,@7]){NSString *mapping=self.prefs[[NSString stringWithFormat:@"pad.%@",id]];[self.engine setButton:id.unsignedIntValue pressed:[pressed[mapping] boolValue] source:1];}
}
- (BOOL)canBecomeFirstResponder{return YES;}
- (NSString *)keyName:(UIKey *)key{switch(key.keyCode){case UIKeyboardHIDUsageKeyboardUpArrow:return @"ArrowUp";case UIKeyboardHIDUsageKeyboardDownArrow:return @"ArrowDown";case UIKeyboardHIDUsageKeyboardLeftArrow:return @"ArrowLeft";case UIKeyboardHIDUsageKeyboardRightArrow:return @"ArrowRight";case UIKeyboardHIDUsageKeyboardReturnOrEnter:return @"Enter";case UIKeyboardHIDUsageKeyboardLeftShift:case UIKeyboardHIDUsageKeyboardRightShift:return @"Shift";default:return key.charactersIgnoringModifiers.lowercaseString;}}
- (void)keys:(NSSet<UIPress *> *)presses down:(BOOL)down{if(![self.prefs[@"input"] isEqual:@"keyboard"])return;for(UIPress *p in presses){NSString *key=[self keyName:p.key];for(NSNumber *id in @[@0,@8,@2,@3,@4,@5,@6,@7])if([self.prefs[[NSString stringWithFormat:@"key.%@",id]] isEqual:key])[self.engine setButton:id.unsignedIntValue pressed:down source:2];}}
- (void)pressesBegan:(NSSet<UIPress *> *)p withEvent:(UIPressesEvent *)e{[self keys:p down:YES];[super pressesBegan:p withEvent:e];}
- (void)pressesEnded:(NSSet<UIPress *> *)p withEvent:(UIPressesEvent *)e{[self keys:p down:NO];[super pressesEnded:p withEvent:e];}
- (void)pressesCancelled:(NSSet<UIPress *> *)p withEvent:(UIPressesEvent *)e{[self keys:p down:NO];[super pressesCancelled:p withEvent:e];}
- (void)showSaves{
