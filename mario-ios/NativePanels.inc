- (void)setDefaultPreferences{
 NSDictionary *d=@{@"volume":@50,@"quality":@"sharp",@"scanlines":@NO,@"rotation":@"0",@"fps":@NO,@"performance":@"stable",@"fast":@NO,@"slow":@NO,@"ffratio":@"3",@"smratio":@"3",@"rewind":@NO,@"autorun":@YES,@"input":@"touch",@"slot":@"1",@"autosave":@"0",@"saveLocation":@"app",@"shotFormat":@"png",@"shotScale":@"1",@"shotSource":@"game",@"deadzone":@"0.35",@"controlSize":@"1",@"showTouch":@YES,@"swapAB":@NO};for(NSString *k in d)if(!self.prefs[k])self.prefs[k]=d[k];
 NSArray *ids=@[@0,@8,@2,@3,@4,@5,@6,@7],*pad=@[@"b",@"a",@"options",@"menu",@"up",@"down",@"left",@"right"],*keys=@[@"z",@"x",@"Shift",@"Enter",@"ArrowUp",@"ArrowDown",@"ArrowLeft",@"ArrowRight"];for(int i=0;i<8;i++){NSString *p=[NSString stringWithFormat:@"pad.%@",ids[i]],*k=[NSString stringWithFormat:@"key.%@",ids[i]];if(!self.prefs[p])self.prefs[p]=pad[i];if(!self.prefs[k])self.prefs[k]=keys[i];}
}
- (void)applyPreferences{
 [self setDefaultPreferences];[NSUserDefaults.standardUserDefaults setObject:self.prefs forKey:@"native.settings"];
 self.engine.volume=[self.prefs[@"muted"] boolValue]?0:[self.prefs[@"volume"] floatValue]/100;self.engine.autoRun=[self.prefs[@"autorun"] boolValue];
 BOOL rewind=[self.prefs[@"rewind"] boolValue];if(self.engine.rewindEnabled!=rewind)self.engine.rewindEnabled=rewind;self.rewindButton.hidden=!rewind;
 self.engine.speed=[self.prefs[@"fast"] boolValue]?[self.prefs[@"ffratio"] doubleValue]:[self.prefs[@"slow"] boolValue]?1/[self.prefs[@"smratio"] doubleValue]:1;
 self.engine.performanceMode=[self.prefs[@"performance"] isEqual:@"battery"]?2:[self.prefs[@"performance"] isEqual:@"smooth"]?1:0;
 self.screen.pixels.magnificationFilter=[self.prefs[@"quality"] isEqual:@"smooth"]?kCAFilterLinear:kCAFilterNearest;self.screen.pixels.minificationFilter=self.screen.pixels.magnificationFilter;
 self.screen.rotation=[self.prefs[@"rotation"] integerValue];self.screen.scanlines=[self.prefs[@"scanlines"] boolValue];[self.screen setNeedsLayout];
 self.fpsLabel.hidden=![self.prefs[@"fps"] boolValue];BOOL touch=[self.prefs[@"input"] isEqual:@"touch"]||[self.prefs[@"showTouch"] boolValue];self.movement.hidden=self.actions.hidden=!touch;
